# 한국관광공사 TourAPI 4.0 서비스키 (공공데이터포털에서 발급, URL 인코딩 안 된 디코딩 키 사용)
#
# 주의: TourAPI는 언어별로 상품(=서비스키)이 따로 발급됨. "국문 관광정보 서비스" 상품 키는
# KorService2 엔드포인트에서만, "영문 관광정보 서비스" 상품 키는 EngService2 엔드포인트에서만
# 동작함 - 서로 안 맞으면 403 Forbidden 남. 공공데이터포털에서 신청한 상품이 어느 언어인지에
# 맞춰서 아래 TOUR_API_BASE_URL도 같이 바꿔야 함.
TOUR_API_SERVICE_KEY=여기에_발급받은_서비스키_입력

# TourAPI 기본 요청 파라미터
# 국문 상품 키를 쓴다면: https://apis.data.go.kr/B551011/KorService2
# 영문 상품 키를 쓴다면: https://apis.data.go.kr/B551011/EngService2
TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/EngService2
TOUR_API_MOBILE_OS=ETC
TOUR_API_MOBILE_APP=KTrip

# DB 접속 정보 (MySQL 기준 예시. 다른 DB 쓰면 이 값만 바꾸면 됨)
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/ktrip

# 기존 Spring Boot 메인 API 주소 (모바일 앱 전용, 웹 버전은 현재 미사용)
MAIN_API_BASE_URL=http://localhost:8080

# Gemini API 키 (무료, scripts/label_themes_with_ai.py 전용) - https://aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=여기에_발급받은_Gemini_API_키_입력
GEMINI_MODEL=gemini-flash-lite-latest

# JWT 인증 설정 (운영 배포 전 JWT_SECRET_KEY는 반드시 랜덤값으로 교체)
JWT_SECRET_KEY=dev-only-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# CORS 허용 origin (콤마로 여러 개 가능). 로컬 개발은 비워두면 전체 허용("*")으로 동작하고,
# 배포 시에는 프론트엔드 실제 주소로 좁힐 것 (예: https://ktrip.vercel.app)
ALLOWED_ORIGINS=*
